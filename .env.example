# Ollama server URL — defaults to a local instance. Make sure `ollama serve` is
# running and the small (stage-1) model has been pulled: `ollama pull qwen2.5:3b`.
OLLAMA_HOST=http://localhost:11434

# Ollama Cloud (used by the stage-2 trend synthesis model — see configs/config.py).
# Two ways to use the cloud model:
#   (a) Easiest: run `ollama signin` once locally — the local daemon will proxy
#       calls for any `*-cloud` model name. No key needed below.
#   (b) Direct: set TRENDS_OLLAMA_HOST=https://ollama.com in configs/config.py
#       and put your key here:
OLLAMA_API_KEY=

# Anthropic key — ONLY needed if you want to rebuild the KG with typed relations.
# QA does not need this. Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
