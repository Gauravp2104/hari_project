# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- Virtual envs ---
.venv/
venv/
env/

# --- Secrets / env ---
.env
.env.local
*.key

# --- Data artifacts ---
# Raw Excel scrapes and runtime answer cache are not deployed.
# Pre-built vector store, KG, and processed parquet ARE committed (via Git LFS)
# so the deployed Hugging Face Space starts hot without a rebuild step.
data/raw/*
data/answer_cache/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/knowledge_graph/.gitkeep
!data/vector_store/.gitkeep

# --- Notebooks ---
.ipynb_checkpoints/

# --- IDE ---
.idea/
.vscode/
*.swp
.DS_Store

# --- Test / coverage ---
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
